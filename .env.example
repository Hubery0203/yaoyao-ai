# YaoYao AI · MVP-001 environment template.
# Copy to .env (never commit .env). Variables marked [Phase N] become required in that phase.

NODE_ENV=development            # development | test | production
PORT=3000
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# [Phase 3] PostgreSQL 16 + pgvector — the only system of record.
# Example: postgres://yaoyao:change-me@postgres:5432/yaoyao
DATABASE_URL=

# [Phase 1+] Redis — idempotency cache, short locks, BullMQ coordination. Never authoritative.
# Example: redis://redis:6379
REDIS_URL=

# [Phase 4] Auth — required once /auth endpoints land.
JWT_ACCESS_SECRET=              # min 32 chars
JWT_ACCESS_TTL_SECONDS=900      # 15 minutes
JWT_ISSUER=yaoyao-ai
JWT_AUDIENCE=yaoyao-app

# MVP-003 continuity worker: comma-separated owner UUIDs; empty = idle.
CONTINUITY_USER_IDS=
CONTINUITY_POLL_MS=2000

# Photos: MiniMax only at runtime; explicit image key/region, no automatic provider fallback.
PHOTOS_ENABLED=0
MINIMAX_IMAGE_API_KEY=
MINIMAX_IMAGE_REGION=cn
MINIMAX_IMAGE_MODEL=image-01
PHOTO_REFERENCE_FILE=/opt/yaoyao-ai/private/photos/reference.png
PHOTO_STORAGE_DIR=/opt/yaoyao-ai/private/photos/spool
PHOTO_MAX_PER_24H=3

# 009D numerical aggregation, per-process 15-minute windows; no raw content or currency billing claims.
PERFORMANCE_LOG_EVERY=10

# Short daily replies prefer speech without time-based alternation; existing rolling cap remains.
VOICE_COOLDOWN_SECONDS=0
