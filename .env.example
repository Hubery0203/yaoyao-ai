# YaoYao AI · MVP-001 environment template.
# Copy to .env (never commit .env). Variables marked [Phase N] become required in that phase.

NODE_ENV=development            # development | test | production
PORT=3000
LOG_LEVEL=info                  # trace | debug | info | warn | error | fatal

# [Phase 3] PostgreSQL 16 + pgvector — the only system of record.
# Example: postgres://yaoyao:change-me@postgres:5432/yaoyao
DATABASE_URL=

# [Phase 1+] Redis — idempotency cache, short locks, BullMQ coordination. Never authoritative.
# Example: redis://redis:6379
REDIS_URL=

# [Phase 4] Auth — required once /auth endpoints land.
JWT_ACCESS_SECRET=              # min 32 chars
JWT_ACCESS_TTL_SECONDS=900      # 15 minutes
JWT_ISSUER=yaoyao-ai
JWT_AUDIENCE=yaoyao-app
